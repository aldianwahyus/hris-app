# ============================================================
# CHECKLIST KEAMANAN PRODUKSI — WAJIB DIUBAH dari nilai contoh
# di bawah sebelum go-live (data HRIS bersifat CONFIDENTIAL):
#   - APP_ENV=production, APP_DEBUG=false (jangan pernah true —
#     membocorkan stack trace/query SQL ke pengguna akhir)
#   - APP_KEY: generate ULANG per lingkungan (`php artisan key:generate`),
#     jangan menyalin dari lingkungan lain
#   - SESSION_SECURE_COOKIE=true (WAJIB di belakang HTTPS)
#   - SESSION_ENCRYPT=true
#   - DB_PASSWORD, AWS_SECRET_ACCESS_KEY: kredensial sungguhan,
#     bukan nilai contoh di bawah (secret/minioadmin)
#   - LOG_LEVEL=info atau lebih ketat (bukan debug)
# ============================================================
APP_NAME="HRIS Bank NTB Syariah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8080

# Zona waktu server WITA. Waktu DISIMPAN sebagai UTC dan dikonversi
# menurut zona waktu unit kerja pegawai — KC Surabaya berada di WIB.

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hris
DB_USERNAME=hris_app
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false

# Token mobile (Sanctum) kedaluwarsa setelah sekian menit — lihat
# config/sanctum.php. 43200 = 30 hari.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# MinIO (S3 compatible)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hris
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

SANCTUM_STATEFUL_DOMAINS=localhost:8080
