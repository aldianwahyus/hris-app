<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <!-- Dijalankan lebih dulu di CI: pelanggaran batas modul harus
             menggagalkan build sebelum uji lain sempat berjalan. -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" WAJIB — docker-compose.yml menyetel APP_ENV=local
             sebagai environment variable kontainer sungguhan untuk service
             app/horizon; tanpa force, PHPUnit TIDAK menimpa env yang sudah
             ada di proses (hanya mengisi yang belum ada), sehingga seluruh
             override di bawah ini diam-diam diabaikan — test berjalan
             dengan APP_ENV=local di database hris (BUKAN hris_testing) dan
             kehilangan bypass CSRF/queue/cache khusus testing Laravel. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="hris_testing" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
    </php>
</phpunit>
