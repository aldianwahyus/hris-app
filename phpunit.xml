<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <!-- Dijalankan lebih dulu di CI: pelanggaran batas modul harus
             menggagalkan build sebelum uji lain sempat berjalan. -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" TIDAK CUKUP di sini — docker-compose.yml membakukan
             APP_ENV=local/DB_DATABASE=hris dkk. LANGSUNG ke $_ENV/$_SERVER
             kontainer sebelum PHP jalan; putenv() milik PHPUnit tidak
             pernah menimpa keduanya. Nilai yang SUNGGUHAN dipaksakan lewat
             tests/bootstrap.php (bootstrap="tests/bootstrap.php" di atas),
             SEBELUM vendor/autoload.php/Dotenv sempat membaca apa pun.
             Baris <env> di bawah ini dipertahankan murni sebagai dokumentasi
             nilai yang dipakai — bukan mekanisme yang benar-benar bekerja. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="hris_testing" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
    </php>
</phpunit>
