# Salin berkas ini menjadi .env dan isi IP LAN mesin dev (BUKAN
# localhost/127.0.0.1 — HP fisik/emulator terpisah tidak bisa
# menjangkau localhost mesin dev).
#
# Cara cek IP LAN: `ipconfig` (Windows, cari "IPv4 Address" di adapter
# Wi-Fi/Ethernet aktif) — pastikan HP dan mesin dev satu jaringan.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api/v1
